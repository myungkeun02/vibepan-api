{
  "name": "vibepan-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/astro/bin/astro.mjs dev --host 127.0.0.1",
    "build": "astro build",
    "start": "node --env-file-if-exists=.env dist/server/entry.mjs",
    "check": "astro check",
    "test": "vitest run",
    "boundaries": "node scripts/check-boundaries.mjs"
  },
  "dependencies": {
    "@astrojs/node": "11.1.5",
    "@aws-sdk/client-s3": "^3.1127.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.0",
    "@fontsource-variable/space-grotesk": "^5.2.0",
    "@resvg/resvg-js": "^2.6.0",
    "astro": "7.3.1",
    "marked": "^17.0.0",
    "nodemailer": "^7.0.0",
    "pg": "^8.23.0",
    "pretendard": "^1.3.9",
    "sanitize-html": "^2.17.0",
    "satori": "^0.33.0",
    "sharp": "^0.35.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@playwright/test": "^1.58.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.0",
    "better-sqlite3": "^13.0.0",
    "icojs": "1.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp"
    ]
  },
